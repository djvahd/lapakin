# Salin ke .env (bukan .env.local) dan isi nilainya. Jangan commit .env.
# Langkah lengkap: docs/setup-neon.md

# Connection string Neon (pilih "Direct connection", bukan pooled, untuk migrasi)
# MIGRATION_URL: role pemilik (neondb_owner), dipakai migrasi dan penyiapan data tes.
# POSTGRES_URL: role aplikasi lapakin_app, dipakai aplikasi agar RLS berlaku (docs/tenancy.md).
# Isi keduanya dengan URL pemilik dulu, lalu `pnpm db:migrate` dan
# `node scripts/set-app-role-password.mjs` memisahkannya.
MIGRATION_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require
POSTGRES_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require

# Buat dengan: openssl rand -base64 32
AUTH_SECRET=

BASE_URL=http://localhost:3000

# Pembayaran langganan (Midtrans). Kosongkan bila belum mendaftar; halaman harga akan menampilkan galat
# saat checkout dan bagian lain tetap berjalan. Ambil di dashboard Midtrans (Settings, Access Keys).
# Produksi: pasang lewat `wrangler secret put MIDTRANS_SERVER_KEY`, bukan di berkas ini.
MIDTRANS_SERVER_KEY=
# true hanya untuk kunci produksi; selain itu sandbox.
MIDTRANS_IS_PRODUCTION=false
